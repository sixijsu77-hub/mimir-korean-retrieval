# This repository is public by design. Default to excluding anything that is
# local, regenerable, or not a deliverable — it is far cheaper to add a file
# later than to remove one from published history.

# --- Local-only working area -------------------------------------------------
# Anything internal goes here. `docs/` is for published deliverables only.
_local/
notes/
scratch/
tmp/
# Working plans are internal notes, not deliverables. Not published.
docs/plans/
*.local
*.local.*
*private*
*internal*
*secret*

# --- Agent / editor / OS -----------------------------------------------------
CLAUDE.md
CLAUDE.local.md
prompt.txt
.claude/
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Credentials -------------------------------------------------------------
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
*.crt
.netrc
.git-credentials
credentials*.json
token*.json
service-account*.json

# --- Python ------------------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# --- Datasets and model weights ----------------------------------------------
# Large and re-downloadable. Revisions are pinned in code, so the exact bytes
# are recoverable without committing them.
data/
models/
.cache/
hf_cache/
.huggingface/
*.safetensors
*.onnx
*.bin
*.pt
*.pth
*.ckpt
*.h5
*.gguf
*.msgpack

# --- Derived indexes and embeddings ------------------------------------------
# Regenerable from the pinned datasets plus committed code.
index/
embeddings/
*.npy
*.npz
*.faiss
*.mmap

# --- Archives and logs -------------------------------------------------------
*.zip
*.tar
*.tar.gz
*.tgz
*.jsonl.gz
*.log
wandb/
runs/
lightning_logs/

# --- Results -----------------------------------------------------------------
# results/*.jsonl IS committed — it is the raw measurement record and every
# table and figure must be regenerable from it. Only bulk intermediates are
# excluded here.
results/**/raw_dump_*.jsonl
results/**/*_scores.npy
results/**/checkpoints/
